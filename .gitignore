# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Symlink to gnssdl data (no trailing slash: a "data/" pattern would not match a symlink)
/data

# Results of imonet runs (data/ is shared with gnssdl)
/runs/

# LaTeX builds (figures/ is tracked so the paper builds without the data)
/paper/*.pdf
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.log
/paper/*.out
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.synctex.gz
